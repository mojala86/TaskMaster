# Copy to .env and adjust. Every value has a default in docker-compose.yml.
#
# The passwords below are LOCAL DEVELOPMENT values. Anywhere shared, set real secrets (or mount
# them as /run/secrets/taskmaster_<setting> files) and TASKMASTER_ENV=production, which refuses
# to start while dev passwords, plaintext connections or anonymous access are still configured.
TASKMASTER_ENV=development

POSTGRES_USER=taskmaster
POSTGRES_PASSWORD=taskmaster
POSTGRES_DB=taskmaster

# Host ports (change if they clash with something already running)
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
S3_PORT=9000
S3_CONSOLE_PORT=9001

# Object storage credentials, and the S3 address clients use for presigned upload/download URLs
S3_ACCESS_KEY=taskmaster
S3_SECRET_KEY=taskmaster-secret
S3_PUBLIC_URL=http://localhost:9000
# Delete uploads no unfinished job needs after this many hours
UPLOAD_RETENTION_HOURS=168

WORKER_REPLICAS=2
WORKER_CONCURRENCY=4
# Crash detection takes about LEASE_SECONDS + 5s; graceful shutdown waits WORKER_SHUTDOWN_TIMEOUT
LEASE_SECONDS=30
WORKER_SHUTDOWN_TIMEOUT=20
RELAY_REPLICAS=1
LOG_LEVEL=INFO
LOG_FORMAT=json

# API keys (create with: docker compose exec api taskmaster apikey create --name me)
REQUIRE_API_KEY=false
RATE_LIMIT_PER_MINUTE=600
ANONYMOUS_RATE_LIMIT_PER_MINUTE=120

# Monitoring profile
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
